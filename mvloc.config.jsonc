{
    "filePatterns": [
        // Files to translate (glob pattern)

        "data/autoBlueprints.xml.append",
		"data/blueprints.xml.append",
		
		"data/events_special_boons.xml.append",
		"data/events_special_lightspeed.xml.append",
		"data/events_special_multiverse.xml.append",
		"data/events_special_storage.xml.append",

		"data/hyperspace.xml.append",
		"data/text_misc.xml.append",

		"mod-appendix/metadata.xml",
    ],
    "stringSelectionXPath": [
        // XML text extraction rules (XPath)

		// blueprints


		"//shipBlueprint/class",

		"//augBlueprint/title",
		"//augBlueprint/desc",
        "//systemBlueprint/title",
        "//systemBlueprint/desc",

		// events
		"//text",
		"//mod:selector",


		// hyperspace
		
		"//mod-append:shipIcon/tooltip",
		"//customTitle/FTL/mod:findLike/mod:findLike/mod-append:category/customTitle",
		"//customStore/category/customTitle",
		"//mod:findLike/mod-append:category/customTitle",
		"//mod-append:customShip/crew/*/@name",
		"//mod-append:page/section/@text",
		"//mod:findLike/mod:selector/@text",
		"//mod-append:achievement/name",
		"//mod-append:achievement/description",
		"//mod-append:achievement/header",
		"//mod-append:achievement/secretName",
		"//mod-append:achievement/secretDescription",

	
		// metadata
		"//metadata/title",
		"//metadata/description",
    ],

    "useDummyRoot": true,

    "languageSpecifics": {
        "ko": {
            "copySourceTemplate": [
                // Aka wont-translate.
                // Specify which entries are 1:1-copied from English by default when syncing the English changes.

                "//crewBlueprint/short",
                "//droneBlueprint/short",
                "//weaponBlueprint/short",
                "//crewMember",
                "//customShip/crew/*/@name",
                "//mod-append:customShip/crew/*/@name",
                "//spawnCrew/name",
            ]
        },
        "zh_Hans": {
            // Apply the translation flagged as fuzzy.
            "applyUseFuzzy": true
        }
    },

    "packaging": {
        "fullOriginal": [
		    //assets1
            "https://github.com/ftl-mv-translation/outer-expansion-systems/raw/outer-expansion-systems-english/FTL-Outer-Expansion-7.1.8_-_Assets.zip",
			//data
			"https://github.com/ftl-mv-translation/outer-expansion-systems/raw/outer-expansion-systems-english/FTL-Outer-Expansion-7.1.10_-_Data.zip",
        ],
        "prefix": "Outer-Expansion-Systems",
        "version": "1.2"
    }
}